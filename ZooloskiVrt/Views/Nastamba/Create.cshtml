@model ZooloskiVrt.Models.Nastamba

@{
    ViewData["Title"] = "Dodaj nastambu";
}

<h3 class="mb-3">@ViewData["Title"]</h3>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label asp-for="Naziv" class="form-label"></label>
        <input asp-for="Naziv" class="form-control" />
        <span asp-validation-for="Naziv" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Tip" class="form-label"></label>
        <input asp-for="Tip" class="form-control" />
        <span asp-validation-for="Tip" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="RazinaOsuncanosti" class="form-label"></label>
        <input asp-for="RazinaOsuncanosti" class="form-control" />
        <span asp-validation-for="RazinaOsuncanosti" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Spremi</button>
    <a asp-action="Index" class="btn btn-secondary">Natrag</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
