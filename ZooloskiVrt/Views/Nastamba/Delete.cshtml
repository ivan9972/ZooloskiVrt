@model ZooloskiVrt.Models.Nastamba
@{
    ViewData["Title"] = "Obriši nastambu";
}

<h2>Obriši nastambu</h2>

<div class="alert alert-warning">
    <p>Jeste li sigurni da želite obrisati ovu nastambu?</p>
</div>

<div>
    <h5>Naziv: @Model.Naziv</h5>
    <h5>Tip: @Model.Tip</h5>
    <h5>Razina osunčanosti: @Model.RazinaOsuncanosti</h5>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="ID" />
    <button type="submit" class="btn btn-danger">Obriši</button>
    <a class="btn btn-secondary" asp-action="Index">Natrag</a>
</form>
