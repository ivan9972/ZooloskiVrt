@model ZooloskiVrt.Models.Incident
@{
    ViewData["Title"] = "Dodaj incident";
}

<h2>Dodaj incident</h2>

<form asp-action="Create" method="post">
    <div class="form-group mb-2">
        <label asp-for="Opis" class="form-label"></label>
        <input asp-for="Opis" class="form-control" />
        <span asp-validation-for="Opis" class="text-danger"></span>
    </div>

    <div class="form-group mb-2">
        <label asp-for="Datum" class="form-label"></label>
        <input asp-for="Datum" type="date" class="form-control" />
    </div>

    <div class="form-group mb-2">
        <label asp-for="Ozbiljnost" class="form-label"></label>
        <input asp-for="Ozbiljnost" class="form-control" />
    </div>

    <div class="form-group mb-2">
        <label>Nastambe</label>
        <select name="Nastambe" asp-items="ViewBag.Nastambe" multiple class="form-select"></select>
    </div>

    <div class="form-group mb-2">
        <label>Životinje</label>
        <select name="Zivotinje" asp-items="ViewBag.Zivotinje" multiple class="form-select"></select>
    </div>

    <button type="submit" class="btn btn-success">Spremi</button>
    <a class="btn btn-secondary" asp-action="Index">Natrag</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
