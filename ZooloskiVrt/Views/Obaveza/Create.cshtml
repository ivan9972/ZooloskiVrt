@model ZooloskiVrt.Models.Obaveza
@{
    ViewData["Title"] = "Dodaj obavezu";
}

<h3>Dodaj obavezu</h3>
<hr />

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Opis" class="form-label"></label>
        <input asp-for="Opis" class="form-control" />
        <span asp-validation-for="Opis" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Datum" class="form-label"></label>
        <input asp-for="Datum" type="date" class="form-control" />
        <span asp-validation-for="Datum" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Status" class="form-label"></label>
        <input asp-for="Status" class="form-control" />
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="RadnikID" class="form-label">Radnik</label>
        <select asp-for="RadnikID" class="form-select" asp-items="ViewBag.RadnikID">
            <option value="">-- Odaberi radnika --</option>
        </select>
        <span asp-validation-for="RadnikID" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="NastambaID" class="form-label">Nastamba</label>
        <select asp-for="NastambaID" class="form-select" asp-items="ViewBag.NastambaID">
            <option value="">-- Odaberi nastambu --</option>
        </select>
        <span asp-validation-for="NastambaID" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Spremi</button>
    <a asp-action="Index" class="btn btn-secondary">Odustani</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
