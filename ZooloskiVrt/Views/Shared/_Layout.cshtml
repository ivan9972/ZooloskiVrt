@{
    var title = ViewData["Title"]?.ToString() ?? "Zoološki vrt";
    var controller = (ViewContext.RouteData.Values["controller"]?.ToString() ?? "").ToLowerInvariant();
    string Active(string c) => controller == c.ToLowerInvariant() ? "active" : "";
}

<!DOCTYPE html>
<html lang="hr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title - Zoološki Vrt</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

    <style>
        :root {
            --g900: #184d1c;
            --g800: #256b2a;
            --g700: #2f7c35;
            --g100: #e8f5e9;
            --bg: #f5f7fb;
            --card: #ffffff;
            --border: #e6eaf2;
            --text: #111827;
            --muted: #6b7280;
            --shadow: 0 12px 30px rgba(17,24,39,.07);
        }

        body {
            background: radial-gradient(1200px 520px at 20% -10%, rgba(46,125,50,.12), transparent 55%), radial-gradient(1000px 520px at 85% 0%, rgba(37,107,42,.10), transparent 55%), var(--bg);
            color: var(--text);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        /* Topbar */
        .topbar {
            height: 64px;
            background: linear-gradient(90deg, rgba(24,77,28,.94), rgba(47,124,53,.94));
            border-bottom: 1px solid rgba(255,255,255,.14);
            box-shadow: 0 10px 28px rgba(0,0,0,.10);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
        }

        .brand {
            font-weight: 900;
            letter-spacing: .2px;
            color: #fff !important;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: .65rem;
        }

            .brand i {
                font-size: 1.25rem;
            }

        /* Layout */
        .app {
            display: flex;
            min-height: calc(100vh - 64px);
        }

        /* Sidebar */
        .sidebar {
            width: 270px;
            background: rgba(255,255,255,.94);
            border-right: 1px solid var(--border);
            position: sticky;
            top: 64px;
            height: calc(100vh - 64px);
            padding: 14px 10px;
        }

        .navlink {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: .8rem;
            padding: 11px 12px;
            margin: 6px 6px;
            border-radius: 14px;
            text-decoration: none;
            color: var(--text);
            transition: .15s ease;
            border: 1px solid transparent;
        }

        .navleft {
            display: flex;
            align-items: center;
            gap: .75rem;
            min-width: 0;
        }

            .navleft span {
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
                font-weight: 600;
            }

        .navlink i {
            font-size: 1.05rem;
            color: var(--g800);
        }

        .navlink:hover {
            background: rgba(232,245,233,.85);
            border-color: rgba(37,107,42,.15);
        }

        .navlink.active {
            background: linear-gradient(135deg, var(--g800), var(--g700));
            color: #fff;
            box-shadow: 0 12px 22px rgba(37,107,42,.22);
        }

            .navlink.active i {
                color: #fff;
            }

        .dot {
            width: 10px;
            height: 10px;
            border-radius: 999px;
            background: rgba(37,107,42,.25);
        }

        .navlink.active .dot {
            background: rgba(255,255,255,.9);
        }

        /* Content */
        .content {
            flex: 1;
            padding: 22px;
        }

        .shell {
            background: rgba(255,255,255,.96);
            border: 1px solid var(--border);
            border-radius: 18px;
            box-shadow: var(--shadow);
            padding: 18px;
        }

        /* Tables */
        table.table {
            background: #fff;
            border-radius: 14px;
            overflow: hidden;
            border: 1px solid var(--border);
        }

            table.table thead {
                background: linear-gradient(90deg, rgba(232,245,233,.95), rgba(232,245,233,.65));
            }

        /* Footer */
        footer {
            border-top: 1px solid var(--border);
            background: rgba(255,255,255,.92);
            color: var(--muted);
            font-size: .9rem;
            padding: 14px 22px;
        }

        @@media (max-width: 992px) {
            .sidebar {
                display: none;
            }

            .content {
                padding: 16px;
            }
        }
    </style>
</head>

<body>
    <!-- Topbar -->
    <nav class="navbar topbar navbar-dark fixed-top">
        <div class="container-fluid px-3">
            <a class="brand" asp-controller="Zivotinja" asp-action="Index">
                <i class="bi bi-tree-fill"></i>
                Zoološki Vrt
            </a>
        </div>
    </nav>

    <div style="height:64px;"></div>

    <div class="app">
        <!-- Sidebar -->
        <aside class="sidebar">
            <a class="navlink @Active("Zivotinja")" asp-controller="Zivotinja" asp-action="Index">
                <span class="navleft"><i class="bi bi-bug-fill"></i><span>Životinje</span></span>
                <span class="dot"></span>
            </a>

            <a class="navlink @Active("Nastamba")" asp-controller="Nastamba" asp-action="Index">
                <span class="navleft"><i class="bi bi-house-heart-fill"></i><span>Nastambe</span></span>
                <span class="dot"></span>
            </a>

            <a class="navlink @Active("Radnik")" asp-controller="Radnik" asp-action="Index">
                <span class="navleft"><i class="bi bi-people-fill"></i><span>Radnici</span></span>
                <span class="dot"></span>
            </a>

            <a class="navlink @Active("Obaveza")" asp-controller="Obaveza" asp-action="Index">
                <span class="navleft"><i class="bi bi-check2-square"></i><span>Obaveze</span></span>
                <span class="dot"></span>
            </a>

            <a class="navlink @Active("Posjetitelj")" asp-controller="Posjetitelj" asp-action="Index">
                <span class="navleft"><i class="bi bi-person-walking"></i><span>Posjetitelji</span></span>
                <span class="dot"></span>
            </a>

            <a class="navlink @Active("Incident")" asp-controller="Incident" asp-action="Index">
                <span class="navleft"><i class="bi bi-exclamation-triangle-fill"></i><span>Incidenti</span></span>
                <span class="dot"></span>
            </a>
        </aside>

        <!-- Content -->
        <main class="content">
            <div class="shell">
                @RenderBody()
            </div>
        </main>
    </div>

    <footer class="mt-4">
        <div class="d-flex justify-content-between flex-wrap gap-2">
            <div>&copy; 2026 Zoološki Vrt</div>
            <div class="text-muted">FSRE • ASP.NET Core MVC</div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
